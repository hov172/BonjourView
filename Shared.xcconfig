// Settings for the BonjourView app target. Project-wide settings live in Base.xcconfig.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
BONJOURVIEW_SHORT_VERSION = 3.0.0
BONJOURVIEW_VERSION = 3.0.0
CODE_SIGN_ENTITLEMENTS = nonsource/BonjourView.entitlements
GENERATE_INFOPLIST_FILE = NO
